<launch>
  <arg name="odometry_topic" value="odometry"/>
  <arg name="camerapose" value="camera_pose"/>


  <group ns="typhoon_h480_0_tracker">
    <arg name="drone_id" value="0"/>
    <include file="$(find mapping)/launch/typhoon_map.launch">
      <arg name="odometry_topic" value="/typhoon_h480_$(arg drone_id)/$(arg odometry_topic)"/>
      <arg name="camerapose" value="/typhoon_h480_$(arg drone_id)/$(arg camerapose)"/>
      <arg name="drone_id" value="$(arg drone_id)"/>
      <arg name="depth_topic" value="/typhoon_h480_$(arg drone_id)/realsense/depth_camera/depth/image_raw"/>
    </include>
    <node name="mapping_vis" pkg="mapping" type="mapping_vis_node">  
      <remap from="~gridmap" to="gridmap"/>
      <remap from="~gridmap_inflate" to="gridmap_inflate"/>
    </node>

    <node pkg="odom_visualization" name="odom_visualization" type="odom_visualization" output="screen">
      <remap from="~odom" to="/typhoon_h480_$(arg drone_id)/$(arg odometry_topic)" />
      <param name="robot_scale" value="1.0"/>
    </node>
    <node pkg="target_ekf" name="target_ekf_sim_node" type="target_ekf_sim_node" output="screen">
      <rosparam command="load" file="$(find target_ekf)/config/typhoon.yaml" />
      <!--not used cam param-->
      <param name="pitch_thr" value="37"/>
      <param name="ekf_rate" value="20"/>

      <remap from="~yolo" to="target/odom"/>
      <remap from="~odom" to="/typhoon_h480_$(arg drone_id)/$(arg odometry_topic)" />
      <remap from="~target_odom" to="target_ekf_odom"/>
    </node>
    <include file="$(find planning)/launch/xtdrone_planning.launch">
      <arg name="rhosVisibility_" value="10000.0"/>
      <arg name="rhoTracking_" value="1000.0"/>
      <arg name="target_name_" value="target_ekf_odom"/>
      <arg name="pose_cmd" value="/typhoon_h480_$(arg drone_id)/cmd_pose_enu"/>
      <arg name="odometry_topic" value="/typhoon_h480_$(arg drone_id)/$(arg odometry_topic)"/>
    </include>
  </group>
</launch>